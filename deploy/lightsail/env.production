# CareLoop の本番（AWS Lightsail）の環境変数。
#
# setup.sh がこのファイルを /var/www/care-loop/.env にコピーし、空欄のうち
# APP_URL・APP_KEY・BLIND_INDEX_KEY・DB_PASSWORD・ANTHROPIC_API_KEY を埋める。
# 秘密の値はサーバーの中でだけ作り、Git にもチャットにも出さない。
#
# 値の理由は docs/02_デプロイ手順.md の 3 章（Laravel Cloud 版）と同じ。
# 違うのはログ・セッションの Cookie・キューの 3 か所で、理由はそれぞれの行に書いた。
# DB_* は Laravel Cloud が自動で入れていた値を、ここでは自分で書いている。

APP_NAME=CareLoop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
APP_URL=

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Laravel Cloud はログを管理画面で見られたが、ここではファイルに残る。
# 1 日 1 ファイルにして 14 日で消し、ディスクを使い切らないようにする。
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info

DB_CONNECTION=mysql
# 同じサーバーの MySQL へは、ネットワークではなくソケット（OS の中の接続口）でつなぐ。
# MySQL 8 の既定の認証方式（caching_sha2_password）は、暗号化していないネットワーク
# 接続だとパスワードの受け渡しに追加の鍵のやり取りを求めるが、ソケットならそのまま通る。
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_DATABASE=care_loop
DB_USERNAME=careloop
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS でしか使わないので、ログインの Cookie を暗号化されていない通信に載せない
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Laravel Cloud では cloud が注入されたが、ここではデータベースのキューを
# systemd のワーカー（careloop-queue.service）が処理する。
# RETRY_AFTER はワーカーの --timeout（90 秒）より長くする。短いと、実行中のジョブが
# 終わったものと見なされ、別のワーカーが同じ AI 処理をもう一度始める。
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

LLM_DRIVER=claude
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=claude-sonnet-5
LLM_MODEL_TRANSFORM=claude-haiku-4-5
LLM_MONTHLY_BUDGET_USD=3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_DEADLINE_SECONDS=70
LLM_JOB_TIMEOUT_SECONDS=85
LLM_MAX_RETRY_WAIT_SECONDS=5

BLIND_INDEX_KEY=

CARELOOP_DEMO=true
FEATURE_REGISTRATION=false
FEATURE_PASSWORD_RESET=false
