APP_NAME=CareLoop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ローカル開発環境が MariaDB(XAMPP) の場合は mariadb に変更してください
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=care_loop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# AI処理はキューで実行します。ローカルでは database を使い、
# php artisan queue:work で処理します（composer dev なら自動で立ち上がります）。
# 本番の Laravel Cloud はマネージドキュー作成時に cloud を注入するため、手で変えません。
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# LLM 連携（Claude API）
#   LLM_DRIVER=claude … 実APIを呼ぶ（ANTHROPIC_API_KEY が必要）
#   LLM_DRIVER=fake   … FakeClient が固定JSONを返す（課金なし・テスト用）
#   ANTHROPIC_API_KEY が空の場合は自動的に fake へフォールバックします
# ---------------------------------------------------------------
LLM_DRIVER=claude
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=claude-opus-5
LLM_MONTHLY_BUDGET_USD=10
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 1回の実行にかけてよい合計時間と、ワーカーがジョブを打ち切る時間。
# 本番の Flex ワーカーは1ジョブ90秒までなので、いずれもそれより短くします。
LLM_DEADLINE_SECONDS=70
LLM_JOB_TIMEOUT_SECONDS=85
LLM_MAX_RETRY_WAIT_SECONDS=5

# 氏名カナの Blind Index（HMAC-SHA256）用の鍵
# php artisan careloop:generate-blind-index-key で生成します
BLIND_INDEX_KEY=

# ---------------------------------------------------------------
# 公開デモ用の設定
#
# デプロイ先でのみ値を変えます。ローカルでは既定のままで構いません。
# ---------------------------------------------------------------

# デモデータを作り直すコマンド（careloop:reset-demo）を許可します。
# ご利用者・記録・職員をすべて削除するため、本番環境では絶対に立てません。
CARELOOP_DEMO=false

# 公開デモでは新規登録を閉じます。誰でもアカウントを作れる状態で公開すると、
# 実APIを無制限に呼び出せてしまうためです。
FEATURE_REGISTRATION=true

# メール送信の手配がない環境では、パスワード再設定も閉じます。
# 押しても何も届かないリンクを出しておくほうが不親切になるためです。
FEATURE_PASSWORD_RESET=true
